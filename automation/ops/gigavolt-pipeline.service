# /etc/systemd/system/gigavolt-pipeline.service - one pipeline run (started by the timer)
[Unit]
Description=Gigavolt data pipeline run
After=mariadb.service mongod.service

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/opt/gigavolt/config.env
WorkingDirectory=/opt/gigavolt/m6/pipeline
ExecStart=/opt/gigavolt_env/bin/python run_pipeline.py --trigger timer
